# Use an address reachable only from your trusted LAN or private overlay network.
BIND_IP=192.0.2.10
PORT=8786

# Existing Docker network shared with the service that exposes the health JSON.
DOCKER_NETWORK=monitoring
STATUS_UPSTREAM=http://monitoring-api:5678/webhook/homelab-health

# Friendly IDs and private addresses used only by the internal WiZ bridge.
WIZ_LIGHTS=light1=192.0.2.20|Light 1,light2=192.0.2.21|Light 2

